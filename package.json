{
  "name": "textlint-rule-no-date-without-actual-date",
  "version": "2.0.1",
  "description": "textlint rule that disallow date without actual date.",
  "keywords": [
    "textlintrule"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omochice/textlint-rule-no-date-without-actual-date.git"
  },
  "license": "MIT",
  "author": "Omochice",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc",
    "check": "biome ci",
    "clean-pkg-json": "clean-pkg-json",
    "fmt": "npm-run-all2 fmt:*",
    "fmt:biome:check": "biome check --write --unsafe .",
    "fmt:biome:format": "biome format --write .",
    "fmt:package": "sort-package-json",
    "prepack": "npm-run-all2 --sequential build clean-pkg-json",
    "test": "node --test \"test/**/*.ts\"",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "date-fns": "^4.0.0",
    "unknownutil": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@textlint/types": "15.8.0",
    "@types/node": "24.13.3",
    "clean-pkg-json": "2.0.0",
    "npm-run-all2": "9.0.3",
    "sort-package-json": "4.0.0",
    "textlint": "15.8.0",
    "textlint-tester": "15.8.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "textlint": "^13.0.0 || ^14.0.0 || ^15.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
